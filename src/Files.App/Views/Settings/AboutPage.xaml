<Page
	x:Class="Files.App.Views.Settings.AboutPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dataitems="using:Files.App.Data.Items"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Page.DataContext>
		<vm:AboutViewModel x:Name="ViewModel" />
	</Page.DataContext>

	<Grid>
		<!-- [UX UPGRADE] Hiệu ứng chuyển trang mượt mà khi người dùng mở Settings -->
		<Grid.Transitions>
			<TransitionCollection>
				<ContentThemeTransition />
			</TransitionCollection>
		</Grid.Transitions>

		<StackPanel
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Padding="0,0,16,16"
			Spacing="4">

			<!-- [UX UPGRADE] Hiệu ứng thác đổ (Cascading) cho các thẻ thông tin -->
			<StackPanel.ChildrenTransitions>
				<TransitionCollection>
					<EntranceThemeTransition FromVerticalOffset="28" IsStaggeringEnabled="True" />
					<RepositionThemeTransition />
				</TransitionCollection>
			</StackPanel.ChildrenTransitions>

			<!--  Title (Sử dụng màu nhấn Cyber Indigo đã định nghĩa ở App.xaml) -->
			<TextBlock
				Padding="0,0,0,16"
				FontSize="28"
				FontWeight="Bold"
				Foreground="{ThemeResource App.Theme.FillColorAttentionBrush}"
				Text="NextFE Studio" />

			<!--  App Info Card (NQV Branding) -->
			<!-- Thay thế binding AppName bằng tên thương hiệu NextFE để gỡ bỏ quảng cáo gốc -->
			<wctcontrols:SettingsCard
				HorizontalAlignment="Stretch"
				Header="NextFE"
				Description="{x:Bind ViewModel.Version}"
				CornerRadius="8"
				BorderThickness="1"
				Background="{ThemeResource App.Theme.FileArea.SecondaryBackgroundBrush}">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE946;" Foreground="{ThemeResource App.Theme.FillColorAttentionBrush}" />
				</wctcontrols:SettingsCard.HeaderIcon>

				<StackPanel Orientation="Horizontal" Spacing="8">
					<!-- Nút Copy thông tin phiên bản -->
					<Button 
						x:Name="CopyVersionInfo" 
						Content="{helpers:ResourceString Name=Copy}"
						CornerRadius="4"
						Padding="16,4">
						<Button.Flyout>
							<MenuFlyout>
								<MenuFlyoutItem Command="{x:Bind ViewModel.CopyAppVersionCommand}" Text="{helpers:ResourceString Name=AppVersion}" />
								<MenuFlyoutItem Command="{x:Bind ViewModel.CopyWindowsVersionCommand}" Text="{helpers:ResourceString Name=WindowsVersion}" />
								<MenuFlyoutItem Command="{x:Bind ViewModel.CopyUserIDCommand}" Text="{helpers:ResourceString Name=UserID}" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</StackPanel>
			</wctcontrols:SettingsCard>

			<!-- Developer Credit Card (Đã thêm thông tin NQV theo yêu cầu) -->
			<wctcontrols:SettingsCard
				Header="Lead Developer"
				Description="NQV (Next-Gen Visuals)"
				CornerRadius="8"
				Margin="0,4,0,0">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource App.Theme.FillColorAttentionBrush}" />
				</wctcontrols:SettingsCard.HeaderIcon>
			</wctcontrols:SettingsCard>

			<!-- [CLEANUP] Đã "cho cook" các thẻ GitHub Sponsor và Discord của tác giả gốc -->

			<!--  Help and support section title  -->
			<TextBlock
				Padding="0,24,0,8"
				FontSize="18"
				FontWeight="SemiBold"
				Text="{helpers:ResourceString Name=HelpAndSupport}" />

			<!--  Documentation  -->
			<wctcontrols:SettingsCard
				HorizontalAlignment="Stretch"
				Command="{x:Bind ViewModel.OpenDocumentationCommand}"
				Header="{helpers:ResourceString Name=Documentation}"
				IsClickEnabled="True"
				CornerRadius="8">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE736;" />
				</wctcontrols:SettingsCard.HeaderIcon>
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE8A7;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

			<!--  Feedback Expander  -->
			<wctcontrols:SettingsExpander 
				HorizontalAlignment="Stretch" 
				Header="{helpers:ResourceString Name=Feedback}"
				CornerRadius="8">
				<wctcontrols:SettingsExpander.HeaderIcon>
					<FontIcon Glyph="&#xED15;" />
				</wctcontrols:SettingsExpander.HeaderIcon>
				<wctcontrols:SettingsExpander.Items>
					<wctcontrols:SettingsCard
						HorizontalAlignment="Stretch"
						Command="{x:Bind ViewModel.SubmitFeatureRequestCommand}"
						Header="{helpers:ResourceString Name=SubmitFeatureRequest}"
						IsClickEnabled="True">
						<wctcontrols:SettingsCard.ActionIcon>
							<FontIcon Glyph="&#xE8A7;" />
						</wctcontrols:SettingsCard.ActionIcon>
					</wctcontrols:SettingsCard>
					<wctcontrols:SettingsCard
						HorizontalAlignment="Stretch"
						Command="{x:Bind ViewModel.SubmitBugReportCommand}"
						Header="{helpers:ResourceString Name=SubmitBugReport}"
						IsClickEnabled="True">
						<wctcontrols:SettingsCard.ActionIcon>
							<FontIcon Glyph="&#xE8A7;" />
						</wctcontrols:SettingsCard.ActionIcon>
					</wctcontrols:SettingsCard>
				</wctcontrols:SettingsExpander.Items>
			</wctcontrols:SettingsExpander>

			<!--  Open Log File Location  -->
			<wctcontrols:SettingsCard
				HorizontalAlignment="Stretch"
				Command="{x:Bind ViewModel.OpenLogLocationCommand}"
				Header="{helpers:ResourceString Name=OpenLogLocation}"
				IsClickEnabled="True"
				CornerRadius="8">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE838;" />
				</wctcontrols:SettingsCard.HeaderIcon>
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE8A7;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

			<!--  Legal section title  -->
			<TextBlock
				Padding="0,24,0,8"
				FontSize="18"
				FontWeight="SemiBold"
				Text="Legal &amp; Privacy" />

			<!--  Third Party Licenses Expander  -->
			<wctcontrols:SettingsExpander 
				Header="{helpers:ResourceString Name=ThirdPartyLibraries}"
				CornerRadius="8">
				<wctcontrols:SettingsExpander.HeaderIcon>
					<FontIcon Glyph="&#xE90F;" />
				</wctcontrols:SettingsExpander.HeaderIcon>
				<wctcontrols:SettingsExpander.Items>
					<wctcontrols:SettingsCard>
						<ItemsRepeater Margin="0,12,0,12" ItemsSource="{x:Bind ViewModel.OpenSourceLibraries, Mode=OneWay}">
							<ItemsRepeater.ItemTemplate>
								<DataTemplate x:DataType="dataitems:OpenSourceLibraryItem">
									<TextBlock Margin="4,0" VerticalAlignment="Center">
										<Hyperlink NavigateUri="{x:Bind Url}" UnderlineStyle="None">
											<Run Text="{x:Bind Name}" />
										</Hyperlink>
									</TextBlock>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
							<ItemsRepeater.Layout>
								<UniformGridLayout
									ItemsStretch="Fill"
									MaximumRowsOrColumns="4"
									MinColumnSpacing="8"
									MinItemWidth="200"
									MinRowSpacing="8"
									Orientation="Horizontal" />
							</ItemsRepeater.Layout>
						</ItemsRepeater>
					</wctcontrols:SettingsCard>
				</wctcontrols:SettingsExpander.Items>
			</wctcontrols:SettingsExpander>

			<!--  Privacy Policy  -->
			<wctcontrols:SettingsCard
				HorizontalAlignment="Stretch"
				Command="{x:Bind ViewModel.OpenPrivacyPolicyCommand}"
				Header="{helpers:ResourceString Name=Privacy}"
				IsClickEnabled="True"
				CornerRadius="8">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE72E;" />
				</wctcontrols:SettingsCard.HeaderIcon>
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE8A7;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

		</StackPanel>
	</Grid>
</Page>